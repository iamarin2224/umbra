{
    "name": "umbra",
    "version": "1.0.0",
    "description": "Private Escrow with ZK Condition Verification on Midnight Network",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "start": "node --env-file-if-exists=.env.local dist/server.js",
        "dev": "vitest",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "tsx --env-file-if-exists=.env.local tests/e2e-preprod.ts",
        "server": "tsx --env-file-if-exists=.env.local src/server.ts",
        "lint": "oxlint src/ tests/ scripts/",
        "typecheck": "tsc --noEmit && tsc --noEmit --ignoreConfig --target ES2022 --module ESNext --moduleResolution bundler --esModuleInterop --skipLibCheck --strict --resolveJsonModule --types node scripts/deploy.ts scripts/deploy-preflight.ts",
        "frontend:dev": "npm --prefix frontend run dev",
        "frontend:build": "npm --prefix frontend run build",
        "frontend:test": "npm --prefix frontend run test",
        "compile:escrow": "compact compile contracts/escrow.compact artifacts",
        "deploy:escrow": "tsx --env-file-if-exists=.env.local scripts/deploy.ts",
        "deploy:preflight": "tsx --env-file-if-exists=.env.local scripts/deploy-preflight.ts",
        "clean": "rm -rf dist artifacts"
    },
    "dependencies": {
        "@midnight-ntwrk/compact-runtime": "^0.16.0",
        "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
        "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
        "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
        "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
        "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
        "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
        "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
        "@midnight-ntwrk/midnight-js-types": "4.1.1",
        "@midnight-ntwrk/midnight-js-utils": "4.1.1",
        "@midnight-ntwrk/wallet-sdk": "1.2.0",
        "@scure/bip39": "^2.4.0",
        "@supabase/supabase-js": "^2.116.0",
        "buffer": "^6.0.3",
        "express": "^5.2.1",
        "rxjs": "^7.8.2",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^22.0.0",
        "@types/ws": "^8.18.1",
        "oxlint": "^1.82.0",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "license": "Apache-2.0",
    "keywords": [
        "midnight",
        "escrow",
        "privacy",
        "zero-knowledge",
        "zkp",
        "blockchain",
        "umbra"
    ]
}
