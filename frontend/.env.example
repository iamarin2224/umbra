# Umbra Frontend environment
# Copy this to frontend/.env.local and fill in your values.

# Express API base URL
VITE_API_URL=http://localhost:3001

# Supabase — used for realtime subscriptions (escrows + escrow_events) and
# fallback reads when the API reports Supabase unconfigured (503).
# Must match the backend SUPABASE_URL / SUPABASE_ANON_KEY project.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Network id passed to the Midnight/Lace DApp connector on connect()
VITE_MIDNIGHT_NETWORK=preprod

# Optional (reserved for future client-side integrations)
# VITE_PROOF_SERVER_URL=
# VITE_INDEXER_URL=
