# Midnight Network Configuration
MIDNIGHT_NETWORK=preprod
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql

# Wallet Configuration (for deployment)
MIDNIGHT_WALLET_SEED=your_wallet_seed_here

# Contract Configuration
CONTRACT_NAME=escrow
CONTRACT_VERSION=1.0.0

# Persistence (required — API returns 503 without these; see .env.supabase.example)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
