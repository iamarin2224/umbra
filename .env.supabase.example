# Umbra Supabase Configuration (backend)
# Copy this to .env.local and fill in your values.
# Apply supabase/schema.sql to the project first (tables + realtime publication).

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Midnight network (optional overrides)
# MIDNIGHT_NETWORK=preprod
# MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql

# API server
# PORT=3001
